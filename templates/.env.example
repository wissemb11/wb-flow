# wb-flow — API keys for the agent CLIs it dispatches to.
#
# Copy this file to ONE of:
#   ~/.wb-flow/.env      global, used by every project        (recommended)
#   ./.env               per-project; takes precedence over the global one
#
# wb-flow never reads an API key itself. These values are loaded into the
# environment so the agent CLIs it spawns (claude, agy, opencode, codex)
# inherit them.
#
# Only keys matching a known provider prefix are loaded — GROQ_, OPENROUTER_,
# ANTHROPIC_, OPENAI_, GEMINI_, GOOGLE_, DEEPSEEK_, MOONSHOT_, ZHIPU_, XAI_,
# MISTRAL_, TOGETHER_, FIREWORKS_, CEREBRAS_, WB_. Anything else in the file is
# skipped and counted on stderr, so an unrelated DATABASE_URL or STRIPE_SECRET_KEY
# in your project's .env is never handed to a third-party agent binary.
#
#   WB_FLOW_ENV_ALLOW="MYVENDOR_"   add your own prefixes
#   WB_FLOW_ENV_ALL=1               load everything (pre-1.0.2 behaviour)
#
# Leave a key blank to skip that provider. wb-flow does NOT add .env to your
# .gitignore — check that yourself before committing.

# Groq (free tier available)
GROQ_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=
