[9.621814, "o", "  3    Stripe provider          1      —            gemini-pro   opus\r\n"]
[9.972817, "o", "  4    Webhook listener         2      1, 3         deepseek     opus\r\n"]
[10.323753, "o", "  5    Checkout UI              2      2            sonnet       opus\r\n"]
[10.674709, "o", "  6    E2E tests                2      4, 5         haiku        sonnet\r\n"]
[11.87577, "o", "\r\n  \u001b[0;90mcheap model for mechanical rows, strong model for hard ones — routed per task\u001b[0m\r\n"]
[15.377368, "o", "\u001b[H\u001b[2J\u001b[3J"]
[15.778438, "o", "\u001b[1;36m# 🌊 wb-flow — agentic AI workflows for any repo\u001b[0m\r\n\r\n\u001b[0;90m# 3. Wave 1 — no dependencies, so all three run at once\u001b[0m\r\n"]
[16.579751, "o", "\u001b[1;32m$\u001b[0m /wbWork --wave=1\r\n"]
[18.180788, "o", "\r\n  dispatching 3 agents in parallel — three different models, one per task…\r\n"]
[19.981807, "o", "\r\n  \u001b[0;32m✓\u001b[0m 1  DB schema            haiku        subscriptions, plans, invoices     42s\r\n"]
[22.182942, "o", "  \u001b[0;32m✓\u001b[0m 2  Billing service      opus         tier logic, proration              51s\r\n"]
[24.584052, "o", "  \u001b[0;32m✓\u001b[0m 3  Stripe provider      gemini-pro   customers, checkout, portal        47s\r\n"]
[26.785064, "o", "\r\n  \u001b[0;90mwall clock 51s — not 140s. The wave is the parallelism.\u001b[0m\r\n"]
[30.386028, "o", "\r\n\u001b[0;90m# 4. Wave 2 — unblocked by wave 1\u001b[0m\r\n"]
[31.187252, "o", "\u001b[1;32m$\u001b[0m /wbWork --wave=2"]
[31.187445, "o", "\r\n"]
[32.788369, "o", "\r\n  \u001b[0;32m✓\u001b[0m 4  Webhook listener     deepseek     signature verify, 6 events         39s\r\n"]
[34.589488, "o", "  \u001b[0;32m✓\u001b[0m 5  Checkout UI          sonnet       plan picker, portal link           44s\r\n"]
[36.390838, "o", "  \u001b[0;32m✓\u001b[0m 6  E2E tests            haiku        12 specs, all green                36s\r\n"]
[38.59192, "o", "\r\n\u001b[0;90m# 5. Validation — a different model grades each task\u001b[0m\r\n"]
[39.392975, "o", "\u001b[1;32m$\u001b[0m /wbValid --wave=all\r\n"]
[40.993907, "o", "  \u001b[0;32m✓\u001b[0m 6/6 validated against their plan rows — no task graded by the model that wrote it\r\n"]
[43.995417, "o", "\u001b[H\u001b[2J\u001b[3J"]
